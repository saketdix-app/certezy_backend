# ── Server ─────────────────────────────
PORT=5000
NODE_ENV=development
APP_NAME=Certezy

# ── Database ───────────────────────────
# NOTE: changing DB_NAME on an existing deployment points the API at a
# different database — keep your current name unless you migrate the data.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=certezy
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=50

# ── JWT ────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Auth cookies ───────────────────────
# Defaults: secure + SameSite=strict in production, lax in development.
# If frontend and API are on different sites, use COOKIE_SAMESITE=none (HTTPS only).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.certezy.com

# ── Redis ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── SMTP (Email) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM="Certezy <noreply@certezy.com>"

# ── Google OAuth ───────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── GitHub OAuth ───────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ── Frontend / CORS ────────────────────
# FRONTEND_URL is required: used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma-separated (e.g. www + apex)
# CORS_ORIGINS=https://certezy.com,https://www.certezy.com

# ── Storage (S3 or DigitalOcean Spaces) ─
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=certezy-bucket
SPACES_REGION=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=

# ── Payments ───────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
